{
  "manifest_version": 3,
  "name": "ArXiv PDF Renamer",
  "version": "1.0.0",
  "description": "Download ArXiv papers with their actual title as filename",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://export.arxiv.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "download-paper": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Download the current ArXiv paper with its title"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
